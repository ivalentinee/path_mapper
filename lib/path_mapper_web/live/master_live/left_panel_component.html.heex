<div class="left-panel" phx-click="noop" phx-target={@myself}>
  <div class="panel-selector">
    {panel_select_button(%{
      text: gettext("Game"),
      panel_name: "game-panel",
      myself: @myself,
      left_panel_state: @left_panel
    })}

    <%= if @game_state do %>
      {panel_select_button(%{
        text: gettext("Maps"),
        panel_name: "surface-selector",
        myself: @myself,
        left_panel_state: @left_panel
      })}
    <% end %>

    <%= if has_surface?(assigns) do %>
      {panel_select_button(%{
        text: gettext("Map"),
        panel_name: "map-manager",
        myself: @myself,
        left_panel_state: @left_panel
      })}
    <% end %>

    <%= if @game_state && @game_state.surface do %>
      {panel_select_button(%{
        text: gettext("Tokens"),
        panel_name: "tokens",
        myself: @myself,
        left_panel_state: @left_panel
      })}
    <% end %>

    <%= if @game_state do %>
      {panel_select_button(%{
        text: gettext("Initiative"),
        panel_name: "initiative",
        myself: @myself,
        left_panel_state: @left_panel
      })}
    <% end %>
  </div>

  <%= if selected_panel(@left_panel) == "game-panel" do %>
    <div class="panel-content">
      <.live_component
        module={PathMapperWeb.MasterLive.LeftPanelComponent.GameComponent}
        id="game-panel"
        characters={@characters}
      />
    </div>
  <% end %>

  <%= if @game_state && selected_panel(@left_panel) == "surface-selector" do %>
    <div class="panel-content">
      <.live_component
        module={PathMapperWeb.MasterLive.LeftPanelComponent.SurfaceSelectorComponent}
        id="surface-selector"
        left_panel={@left_panel}
        game_state={@game_state}
      />
    </div>
  <% end %>

  <%= if has_surface?(assigns) && selected_panel(@left_panel) == "map-manager" do %>
    <div class="panel-content">
      <.live_component
        module={PathMapperWeb.MasterLive.LeftPanelComponent.MapManagerComponent}
        id="map-manager"
        left_panel={@left_panel}
        game_state={@game_state}
      />
    </div>
  <% end %>

  <%= if @game_state && selected_panel(@left_panel) == "tokens" do %>
    <div class="panel-content">
      <.live_component
        module={PathMapperWeb.MasterLive.LeftPanelComponent.TokensComponent}
        id="tokens"
        left_panel={@left_panel}
        game_state={@game_state}
        characters={@characters}
      />
    </div>
  <% end %>

  <%= if @game_state && selected_panel(@left_panel) == "initiative" do %>
    <div class="panel-content">
      <.live_component
        module={PathMapperWeb.MasterLive.LeftPanelComponent.InitiativeComponent}
        id="initiative"
        game_state={@game_state}
      />
    </div>
  <% end %>
</div>
