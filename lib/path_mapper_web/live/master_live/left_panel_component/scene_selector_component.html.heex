<div id="scene-selector" class="scene-selector">
  <div class="sub-buttons">
    <button
      id="unset_scene"
      phx-click="unset_scene"
      phx-target={@myself}
      class="pure-button sub-button"
      disabled={@game_state.scene == nil}
    >
      {gettext("Unset")}
    </button>
    <button
      id="reset_scene"
      phx-click="reset_scene"
      phx-target={@myself}
      class={"pure-button sub-button #{if assigns[:confirm_reset], do: "confirm", else: ""}"}
      disabled={@game_state.scene == nil || (@game_state.scene && @game_state.scene.custom)}
      title={
        if @game_state.scene && @game_state.scene.custom,
          do: gettext("Reset is not available for custom scenes"),
          else: nil
      }
    >
      {if assigns[:confirm_reset], do: gettext("Confirm?"), else: gettext("Reset")}
    </button>
  </div>

  <% adventure_scenes = @game_state.scene_list || [] %>

  <%!-- The access index is the position on screen, derived here and stored nowhere. --%>
  <%= for {item, access_index} <- Enum.with_index(adventure_scenes, 1) do %>
    <button
      phx-click="select_scene"
      phx-target={@myself}
      phx-value-id={item.id}
      class={"pure-button item #{select_button_extra_classes(item.id, @game_state.scene)}"}
    >
      <span class="index">{access_index}</span>
      <%= if item.ref do %>
        <span class="scene-ref">{item.ref}</span>
      <% end %>
      <span class="item-name">{item.name}</span>
    </button>
  <% end %>
</div>
