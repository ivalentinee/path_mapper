<div id="add-token" class="add-token">
  <div class="token-search-controls">
    <button
      class={"pure-button sub-button #{if @expanded, do: "active"}"}
      phx-click="toggle_expanded"
      phx-target={@myself}
      title={if @expanded, do: gettext("Hide the search"), else: gettext("Search the tokens")}
    >
      {if @expanded, do: gettext("×"), else: gettext("Search")}
    </button>
    <%= if @expanded do %>
      <form
        id="token-search-form"
        phx-change="search"
        phx-target={@myself}
        class="token-search-form"
      >
        <input
          type="text"
          name="search"
          value={@search}
          placeholder={gettext("Search tokens...")}
          class="token-search-input"
          autocomplete="off"
          phx-debounce="150"
        />
      </form>
    <% end %>
  </div>

  <%= for token <- @visible_tokens do %>
    <div class="item">
      <button phx-click="add_token" phx-value-id={token.id} phx-target={@myself}>
        {token.name}
      </button>
    </div>
  <% end %>

  <%= if @visible_tokens == [] do %>
    <div class="panel-empty">{gettext("No tokens found")}</div>
  <% end %>
</div>
