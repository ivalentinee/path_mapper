#!/bin/sh

# PathMapper runs as one instance and clusters with nothing, so it has no use for
# Erlang distribution. Left at the default, a release starts a named node, which
# starts epmd listening on 4369 - a port worth nothing here and worth scanning
# from outside. "none" is how the release declines to open it.
#
# The cost is the commands that reach the running node over distribution:
# `remote`, `rpc`, `pid`, `restart` and `stop`. A service manager stops the
# release with SIGTERM instead, which the VM already shuts down cleanly on.
export RELEASE_DISTRIBUTION=none
